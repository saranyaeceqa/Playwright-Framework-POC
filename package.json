{
  "name": "playwright-framework-poc",
  "version": "1.0.0",
  "description": "A scalable automation framework using Playwright, TypeScript, and the Page Object Model (POM) pattern for robust end-to-end web testing.",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "headed": "playwright test --headed",
    "chromium": "playwright test --project=chromium",
    "chrome": "playwright test --project=chrome",
    "firefox": "playwright test --project=firefox",
    "report": "playwright show-report",
    "allurereport": "allure generate allure-results --clean -o allure-report && allure open allure-report",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saranyaeceqa/Playwright-Framework-POC.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/saranyaeceqa/Playwright-Framework-POC/issues"
  },
  "homepage": "https://github.com/saranyaeceqa/Playwright-Framework-POC#readme",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "allure-commandline": "^2.34.1",
    "allure-playwright": "^3.3.0"
  }
}
